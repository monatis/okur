{
  "code-quality-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\stop-hook.ps1",
        "timeout": 45
      }
    ]
  },
  "no-panic-quality-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\check-no-unwrap-hook.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
