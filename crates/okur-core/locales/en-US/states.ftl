## State words: said after a control's role, in the role's voice.
## Okur adds the marks around them when it speaks; the words here never hold them.

state-checked = checked
state-not-checked = not checked
# A native tree item that shows its children.
state-open = open
# A native tree item that hides its children.
state-closed = closed
state-collapsed = collapsed
state-expanded = expanded
# The element opens a popup (aria-haspopup); its kind follows. JAWS's spacing and capitals.
state-has-popup = Has Popup
state-pressed = Pressed
state-not-pressed = Not pressed
state-required = Required
state-selected = selected
# A menu item that opens another menu.
state-sub-menu = sub menu
