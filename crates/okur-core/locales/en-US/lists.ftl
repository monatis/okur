## The element lists (Insert+F7, Insert+F6, Insert+F5): what is said as one opens.
## JAWS's own titles and list names.

list-dialog-links = Links List
# The name of the Links List's list of links.
list-dialog-links-list = links
list-dialog-headings = Heading List
# The name of the Heading List's list of headings.
list-dialog-headings-list = headings
list-dialog-form-fields = Select a Form Field
# The name of the Form Fields list's list, as JAWS's dialog names it.
list-dialog-form-fields-list = List1
