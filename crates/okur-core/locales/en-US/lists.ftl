list-none-radio-buttons = no radio buttons were found
list-none-buttons = no Buttons were found
list-none-controls = no Selectable Aria controls, ComboBoxes, lists or TreeViews were found
list-none-edits = no edit boxes were found
list-none-check-boxes = no Check boxes were found
list-none-graphics = no graphics were found
list-none-lists = no lists were found
list-none-articles = no articles were found
list-none-paragraphs = no paragraphs were found
list-none-block-quotes = no block quotes were found
list-none-tables = No tables found
