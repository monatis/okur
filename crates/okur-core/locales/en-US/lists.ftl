## The element lists (Insert+F7, Insert+F6, Insert+F5): what is said as one opens.
## JAWS's own titles and list names.

list-dialog-links = Links List
# The name of the Links List's list of links.
list-dialog-links-list = links
list-dialog-headings = Heading List
# The name of the Heading List's list of headings.
list-dialog-headings-list = headings
list-dialog-form-fields = Select a Form Field
# Word's fields, Insert+F5 in a document [obs, 1050/s1].
list-dialog-document-fields = List Fields
# Word's comments, Ctrl+Shift+Apostrophe in a document [obs, 1082/s1].
list-dialog-comments = Reviewers' Comments
# Word's footnotes, Insert+Shift+F in a document [obs, 1083/s1].
list-dialog-footnotes = Footnotes
# Word's endnotes, Insert+Shift+E in a document [obs, 1090/s1].
list-dialog-endnotes = End Notes
# Word's bookmarks, Insert+Alt+B in a document [obs, 1091/s1].
list-dialog-bookmarks = Bookmark List
# The name of the Form Fields list's list, as JAWS's dialog names it.
list-dialog-form-fields-list = List1
list-dialog-features = Virtual HTML Features
# The name of Virtual HTML Features' list of lists, as JAWS's dialog names it.
list-dialog-features-list = List1

## Virtual HTML Features' lists (Insert+F3), JAWS's names, in its order.

html-feature-anchors = Anchors List
html-feature-articles = Articles List
html-feature-block-quotes = Block Quotes List
html-feature-buttons = Buttons List
html-feature-check-boxes = Check Boxes List
html-feature-controls = Controls (Selectable ARIA, combo, lists and trees) List
html-feature-divisions = Divisions List
html-feature-edit-boxes = Edit Boxes List
html-feature-form-fields = Form Fields List
html-feature-frames = Frames List
html-feature-graphics = Graphics List
html-feature-headings = Headings List
html-feature-links = Links List
html-feature-list-items = List Items List
html-feature-lists = Lists List
html-feature-paragraphs = Paragraphs List
html-feature-placemarkers = PlaceMarkers
# JAWS shows "Radio Buttons List," with a stray comma: an accepted divergence.
html-feature-radio-buttons = Radio Buttons List
html-feature-regions = Regions List
html-feature-smart-glance = Smart Glance Highlight List
html-feature-tables = Tables List
html-feature-tabs = Tabs List
# Okur's own words: the list chosen in Virtual HTML Features is not built yet.
html-feature-not-yet = Okur has no { $list } yet.

## JAWS's element lists (Insert+Ctrl and a letter), their titles as JAWS's [obs, 231-245].

list-dialog-radio-buttons = Select a Radio Button
list-dialog-buttons = Select a Button
list-dialog-controls = Selectable ARIA controls, comboboxes, listboxes or treeviews
list-dialog-edits = Select an Edit Box
list-dialog-check-boxes = Select a Check Box
list-dialog-graphics = Select a Graphic
list-dialog-lists = Select a List
# JAWS writes "article" in lower case here.
list-dialog-articles = Select an article
list-dialog-paragraphs = Select a Paragraph
list-dialog-block-quotes = Select a Block Quote
list-dialog-tables = Select a Table
list-dialog-divisions = Select a Division
list-dialog-tabs = Select a Tab
# A table in Select a Table: its caption and size, "Branch hours after the change 3x3".
element-list-table = { $caption } { $columns }x{ $rows }

