## Words of Okur's application modules (crates/okur-core/src/apps), as JAWS's application
## scripts say them.

# The Windows desktop taking the focus, as JAWS names it.
desktop = desktop
# A desktop icon the system gives no name.
desktop-item-unnamed = Desktop
# The hint for the desktop's icons. JAWS's lowercase "f2".
hint-desktop-rename = To edit the selected item press f2.

# File Explorer's window when it gives no title.
explorer-title = File Explorer
# A file or folder the system gives no name.
explorer-item-unnamed = Item
# An item of File Explorer's file list that is not selected, said before its name.
explorer-item-not-selected = Not Selected { $name }
