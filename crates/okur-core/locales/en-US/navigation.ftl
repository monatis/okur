## Quick navigation in a page (H, K, F, T…) and the virtual cursor's other moves.

# No element of the kind is on the page.
quicknav-none-articles = There are no articles on this page.
quicknav-none-buttons = There are no buttons on this page.
quicknav-none-check-boxes = There are no check boxes on this page.
quicknav-none-combo-boxes = There are no combo boxes on this page.
quicknav-none-edit-fields = There are no edit fields on this page.
quicknav-none-form-fields = There are no form fields on this page.
# JAWS ends this one without a period.
quicknav-none-frames = There are no frames on this page
quicknav-none-graphics = There are no graphics on this page.
quicknav-none-headings = There are no headings on this page.
quicknav-none-links = There are no links on this page.
quicknav-none-visited-links = There are no visited links on this page.
quicknav-none-unvisited-links = There are no unvisited links on this page.
quicknav-none-list-items = There are no list items on this page.
quicknav-none-lists = There are no lists on this page.
quicknav-none-math = There are no math equations on this page.
# Elements that react to the mouse moving over them (onMouseOver).
quicknav-none-on-mouse-over = There are no onMouseOver elements on this page.
# Elements with a click handler (onClick).
quicknav-none-clickable = There are no clickable elements on this page.
# aria-flowto: the element at the cursor flows to no other, or none flows to it.
quicknav-none-flows = No more flows found
# Said after an element with aria-flowto.
flow-has-flows-to = Has Flows To
# The element a flow goes to, after its line [obs, 563/s8].
flow-has-flows-from = Has Flows From
# Place markers: places on a page the user marked.
quicknav-none-placemarkers = There are no PlaceMarkers on this page.
# Ctrl+Windows+K, before the line the cursor is on.
placemarker-temporary-set = Temporary PlaceMarker set
# 7, 8, 9, 0 (or with Shift) for a PlaceMarker the page does not have [obs, 702/s14].
placemarker-none-numbered = No place marker #{ $number }
quicknav-none-radio-buttons = There are no radio buttons on this page.
quicknav-none-regions = There are no regions on this page.
quicknav-none-tables = There are no tables on this page.

# The next element of the kind is above the cursor: the search went on from the top.
quicknav-wrap-top = wrapping to top
# The previous element of the kind is below the cursor: the search went on from the bottom.
quicknav-wrap-bottom = wrapping to bottom

# A heading level key (1 to 6) found no heading of its level after the cursor. JAWS writes
# "level1" without a space.
quicknav-heading-level-none-top = No more headings at level1.
quicknav-heading-level-none = No more headings at level{ $level } in this section.

# Entering a math equation's viewer.
math-viewer-entered = Math Viewer. Press Escape to exit.
# Quick keys with nothing to go to. JAWS's wording for these was not recorded.
quicknav-none-mail-links = There are no mail links on this page.
quicknav-none-separators = There are no separators on this page.
quicknav-none-divisions = There are no divisions on this page.

# S and Shift+S where the cursor is on no element (a list's start) [obs, 558/s11, s12].
quicknav-none-same-next = No more elements of same type found
quicknav-none-same-prior = No prior elements of same type found
# D on a page whose elements are all of one type. JAWS's wording was not recorded.
quicknav-none-different = No more elements of different type found
