{
  "id": "43-treeview-expand-collapse",
  "name": "ARIA TreeView Expansion, Collapse and Parent Navigation",
  "category": "Complex ARIA Widgets",
  "version": "1.1.0",
  "fixture": "file:///C:/Users/ailabs/corpus/fixtures/aria-widgets.html",
  "target_app": "chrome",
  "reset": {
    "keystrokes": [
      "^{HOME}"
    ],
    "exit_forms_mode": true
  },
  "steps": [
    {
      "id": "s1",
      "type": "focus",
      "command": "Projects",
      "settle_ms": 300,
      "assertions": {
        "target_role": "treeitem",
        "target_name": "Projects",
        "contains_speech": [
          "Projects",
          "level 1",
          "collapsed"
        ]
      }
    },
    {
      "id": "s2",
      "type": "keyboard",
      "command": "{RIGHT}",
      "settle_ms": 200,
      "assertions": {
        "contains_speech": [
          "expanded"
        ]
      }
    },
    {
      "id": "s3",
      "type": "keyboard",
      "command": "{LEFT}",
      "settle_ms": 200,
      "assertions": {
        "contains_speech": [
          "collapsed"
        ]
      }
    },
    {
      "id": "s4",
      "type": "focus",
      "command": "Work",
      "settle_ms": 300,
      "assertions": {
        "target_role": "treeitem",
        "target_name": "Work",
        "contains_speech": [
          "Work",
          "level 2",
          "collapsed"
        ]
      }
    },
    {
      "id": "s5",
      "type": "keyboard",
      "command": "{LEFT}",
      "settle_ms": 200,
      "assertions": {
        "target_role": "treeitem",
        "target_name": "Documents",
        "contains_speech": [
          "Documents",
          "level 1"
        ]
      }
    }
  ]
}
