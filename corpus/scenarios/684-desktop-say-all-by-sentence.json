{
  "id": "684-desktop-say-all-by-sentence",
  "name": "Say All (Insert+Down) in a WinForms text box from \"Say All reads this. It has three sentences. The last one ends here.\", with JAWS's Say All Reads at Sentence (DEFAULT.JCF Options SayAllMode=1): once to the end, Insert+Up where it stopped, then again from the same line with Right during it",
  "category": "desktop",
  "version": "1.0.0",
  "fixture": "file:///C:/Users/ailabs/corpus/fixtures/desktop-reading.ps1",
  "target_app": "desktop",
  "launch": {
    "window_title": "SR Reading Fixture"
  },
  "reset": {
    "keys": [
      "Ctrl+Home",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down",
      "Down"
    ]
  },
  "steps": [
    {
      "id": "s1",
      "type": "key",
      "command": "Insert+Down",
      "settle_max_ms": 60000,
      "quiet_ms": 1500
    },
    {
      "id": "s2",
      "type": "key",
      "command": "Insert+Up"
    },
    {
      "id": "s3",
      "type": "key",
      "command": "Up"
    },
    {
      "id": "s4",
      "type": "key",
      "command": "Home"
    },
    {
      "id": "s5",
      "type": "key",
      "command": "Insert+Down",
      "settle_max_ms": 60000,
      "quiet_ms": 1500,
      "during": [
        {
          "after_ms": 700,
          "command": "Right"
        }
      ]
    },
    {
      "id": "s6",
      "type": "key",
      "command": "Insert+Up"
    }
  ],
  "jaws_settings": {
    "DEFAULT.JCF": {
      "Options": {
        "SayAllMode": "1"
      }
    }
  }
}
