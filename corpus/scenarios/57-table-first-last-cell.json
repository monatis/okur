{
  "id": "57-table-first-last-cell",
  "name": "Jump to Table First and Last Cells",
  "category": "Complex Table Headers and Coordinates",
  "version": "1.1.0",
  "fixture": "file:///C:/Users/ailabs/corpus/fixtures/tables-navigation.html",
  "target_app": "chrome",
  "reset": {
    "keystrokes": [
      "^{HOME}"
    ],
    "exit_forms_mode": true
  },
  "steps": [
    {
      "id": "s1",
      "type": "jaws_script",
      "command": "MoveToNextTable",
      "settle_ms": 300,
      "assertions": {
        "target_role": "table",
        "contains_speech": [
          "table with 4 columns and 4 rows",
          "Column 1, Row 1"
        ]
      }
    },
    {
      "id": "s2",
      "type": "keyboard",
      "command": "^%{END}",
      "settle_ms": 200,
      "assertions": {
        "contains_speech": [
          "Profit",
          "Q3",
          "$8,800",
          "Column 4, Row 4"
        ]
      }
    },
    {
      "id": "s3",
      "type": "keyboard",
      "command": "^%{HOME}",
      "settle_ms": 200,
      "assertions": {
        "contains_speech": [
          "Quarter",
          "Column 1, Row 1"
        ]
      }
    }
  ]
}
