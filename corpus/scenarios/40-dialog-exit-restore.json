{
  "id": "40-dialog-exit-restore",
  "name": "Web Modal Dialog Exit and Global Navigation Restoration",
  "category": "Web Dialogs and Modal Traps",
  "version": "1.1.0",
  "fixture": "file:///C:/Users/ailabs/corpus/fixtures/dialog-and-formatting.html",
  "target_app": "chrome",
  "reset": {
    "keystrokes": [
      "^{HOME}"
    ],
    "exit_forms_mode": true
  },
  "steps": [
    {
      "id": "s1",
      "type": "focus",
      "command": "Confirm Account Deletion",
      "settle_ms": 300,
      "assertions": {
        "target_role": "dialog",
        "target_name": "Confirm Account Deletion",
        "contains_speech": [
          "Dialog Confirm Account Deletion"
        ]
      }
    },
    {
      "id": "s2",
      "type": "keyboard",
      "command": "{ESC}",
      "settle_ms": 200,
      "assertions": {
        "contains_speech": [
          "Leaving Dialog"
        ]
      }
    },
    {
      "id": "s3",
      "type": "keyboard",
      "command": "H",
      "settle_ms": 200,
      "assertions": {
        "target_role": "heading",
        "target_name": "System Overview",
        "contains_speech": [
          "System Overview",
          "heading level 1"
        ]
      }
    }
  ]
}
