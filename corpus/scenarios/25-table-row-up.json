{
  "id": "25-table-row-up",
  "name": "Navigate Prior Row via Ctrl+Alt+Up",
  "category": "Tables and Cell Navigation",
  "version": "1.1.0",
  "fixture": "file:///C:/Users/ailabs/corpus/fixtures/tables-navigation.html",
  "target_app": "chrome",
  "reset": {
    "keystrokes": [
      "^{HOME}"
    ],
    "exit_forms_mode": true
  },
  "steps": [
    {
      "id": "s1",
      "type": "jaws_script",
      "command": "MoveToNextTable",
      "settle_ms": 350,
      "assertions": {
        "target_role": "table",
        "contains_speech": [
          "table with 4 columns and 4 rows"
        ]
      }
    },
    {
      "id": "s2",
      "type": "keyboard",
      "command": "^%{DOWN}",
      "settle_ms": 350,
      "assertions": {
        "contains_speech": [
          "Row 2"
        ]
      }
    },
    {
      "id": "s3",
      "type": "keyboard",
      "command": "^%{UP}",
      "settle_ms": 350,
      "assertions": {
        "contains_speech": [
          "Row 1"
        ],
        "target_row": 1
      }
    }
  ]
}
