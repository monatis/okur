{
  "id": "769-web-skim-read-by-sentence",
  "name": "Skim reading by first sentence: Ctrl+Shift+Insert+Down, Down Arrow (Read First Sentence of Every Paragraph) and Alt+S (Start Skim Reading) typed by JAWS, Insert+Up, then the dialog again to learn whether the choice stayed, Escape typed by JAWS, Insert+Up (one trial: the choice may be saved)",
  "category": "realistic-pages",
  "version": "1.0.0",
  "fixture": "file:///C:/Users/ailabs/corpus/fixtures/news-article.html",
  "target_app": "chrome",
  "reset": {
    "keys": [
      "Ctrl+Home"
    ]
  },
  "steps": [
    {
      "type": "key",
      "command": "Ctrl+Shift+Insert+Down",
      "settle_max_ms": 30000,
      "id": "s1"
    },
    {
      "type": "jaws_function",
      "command": "TypeKey(\"DownArrow\")",
      "id": "s2"
    },
    {
      "type": "jaws_function",
      "command": "TypeKey(\"Alt+S\")",
      "settle_max_ms": 150000,
      "id": "s3"
    },
    {
      "type": "key",
      "command": "Insert+Up",
      "id": "s4"
    },
    {
      "type": "key",
      "command": "Ctrl+Shift+Insert+Down",
      "settle_max_ms": 30000,
      "id": "s5"
    },
    {
      "type": "jaws_function",
      "command": "TypeKey(\"Escape\")",
      "settle_max_ms": 30000,
      "id": "s6"
    },
    {
      "type": "key",
      "command": "Insert+Up",
      "id": "s7"
    }
  ]
}
