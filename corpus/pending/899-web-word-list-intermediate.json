{
  "id": "899-web-word-list-intermediate",
  "name": "The Word List: Ctrl+Insert+W opens it (closed with Escape), W with none chosen, then Ctrl+Insert+W again, Down and Enter to choose a word, Say Line, W and Shift+W to its next and prior place; keys in JAWS's dialog through its TypeKey (at JAWS's Intermediate verbosity, DEFAULT.JCF Options Verbosity=1; otherwise as 560-web-word-list)",
  "category": "realistic-pages",
  "version": "1.0.0",
  "fixture": "file:///C:/Users/ailabs/corpus/fixtures/news-article.html",
  "target_app": "chrome",
  "reset": {
    "keys": [
      "Ctrl+Home"
    ]
  },
  "steps": [
    {
      "id": "s1",
      "type": "key",
      "command": "Ctrl+Insert+W"
    },
    {
      "id": "s2",
      "type": "jaws_function",
      "command": "TypeKey(\"Escape\")"
    },
    {
      "id": "s3",
      "type": "key",
      "command": "W"
    },
    {
      "id": "s4",
      "type": "key",
      "command": "Ctrl+Insert+W"
    },
    {
      "id": "s5",
      "type": "jaws_function",
      "command": "TypeKey(\"Down\")"
    },
    {
      "id": "s6",
      "type": "jaws_function",
      "command": "TypeKey(\"Enter\")"
    },
    {
      "id": "s7",
      "type": "key",
      "command": "Insert+Up"
    },
    {
      "id": "s8",
      "type": "key",
      "command": "W"
    },
    {
      "id": "s9",
      "type": "key",
      "command": "W"
    },
    {
      "id": "s10",
      "type": "key",
      "command": "Shift+W"
    }
  ],
  "jaws_settings": {
    "DEFAULT.JCF": {
      "Options": {
        "Verbosity": "1"
      }
    }
  }
}
