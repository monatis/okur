{
  "id": "820-desktop-uia-notification-in-history",
  "name": "An application's own UI Automation notification (not a toast): Space on Send update, Insert+Space, N (the Notification History), Enter on the list's first item (its details), Escape twice, then Insert+Space, Shift+N (the most recent notification), typed by JAWS in the history (its window refuses our keys)",
  "category": "desktop",
  "version": "1.0.0",
  "fixture": "file:///C:/Users/ailabs/corpus/fixtures/desktop-uia-notifications.ps1",
  "target_app": "desktop",
  "launch": {
    "window_title": "SR UIA Notification Fixture"
  },
  "expects_notifications": true,
  "reset": {
    "keys": []
  },
  "steps": [
    {
      "id": "s1",
      "type": "key",
      "command": "Space",
      "settle_max_ms": 20000
    },
    {
      "id": "s2",
      "type": "key",
      "command": "Insert+Space"
    },
    {
      "id": "s3",
      "type": "key",
      "command": "N",
      "settle_max_ms": 15000
    },
    {
      "id": "s4",
      "type": "jaws_function",
      "command": "TypeKey(\"Enter\")"
    },
    {
      "id": "s5",
      "type": "jaws_function",
      "command": "TypeKey(\"Escape\")"
    },
    {
      "id": "s6",
      "type": "jaws_function",
      "command": "TypeKey(\"Escape\")"
    },
    {
      "id": "s7",
      "type": "key",
      "command": "Insert+Space"
    },
    {
      "id": "s8",
      "type": "key",
      "command": "Shift+N"
    }
  ]
}
